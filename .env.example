# =====================================================================
#  AI GrandKid settings. Copy this file to ".env" and fill in your key.
#  With no key the app still runs in "mock" mode (fixed, rule-based replies).
# =====================================================================

# ---------- AI model (needed for the real demo) ----------
# DeepSeek:
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_VISION_MODEL=deepseek-chat
# OpenAI instead:     LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Tencent TokenHub:   LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1   LLM_MODEL=<model id from TokenHub>

# Language the AI uses with YOU (the child) in the family app
CHILD_LANG=English

# ---------- Voice (optional) ----------
# Speech-to-text for Mum's voice notes: none | openai | tencent   (DeepSeek has none, keep "none")
ASR_PROVIDER=none
# Cantonese voice replies to Mum (free, needs internet + ffmpeg)
TTS_ENABLED=false

# ---------- The family ----------
PARENT_NAME=Mum (黃太)
PARENT_NICKNAME=婆婆
CHILD_NAME=Ka Yan
CHILD_NAME_ZH=嘉欣
CHILD_CITY=London
CHILD_CITY_ZH=倫敦
PARENT_TZ=Asia/Hong_Kong
CHILD_TZ=Europe/London

# ---------- Demo ----------
# true = confirmed plans happen immediately (the demo clock jumps to their time) and the app starts empty every time
DEMO_INSTANT=true
RESET_ON_START=true

# ---------- Timing ----------
# Mum's waking hours (HK time): the AI only messages her inside them
WAKE_START=08:30
WAKE_END=21:30
# Messages you write while Mum sleeps are delivered at this HK time
MORNING_DELIVERY=09:15
# Your morning brief arrives at this time in YOUR time zone
BRIEF_TIME=07:30

# ---------- Optional: speech-to-text keys ----------
OPENAI_ASR_BASE_URL=https://api.openai.com/v1
OPENAI_ASR_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_yue

# ---------- Optional: real WhatsApp for Mum (production path) ----------
# Leave empty to use the built-in WhatsApp-style simulator.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aigrandkid-verify
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
DEMO_PARENT_WA=
